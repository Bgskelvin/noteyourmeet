# Salin jadi apps/api/.env lalu isi. JANGAN commit file .env.

# --- Wajib untuk deteksi pembicara (gratis) ---
# 1. Buat akun di https://huggingface.co lalu buat token (Settings > Access Tokens, tipe "Read")
# 2. Buka https://huggingface.co/pyannote/speaker-diarization-community-1 lalu isi form & klik "Agree"
HF_TOKEN=

# --- Transkripsi ---
# whisperx = pakai GPU; fake = data contoh untuk coba UI tanpa GPU
TRANSCRIPTION_PROVIDER=whisperx
WHISPER_MODEL=large-v3-turbo
# int8_float16 = hemat VRAM & cepat. Jika hasil kosong/aneh di GTX 16xx, ganti ke int8
WHISPER_COMPUTE_TYPE=int8_float16
WHISPER_BATCH_SIZE=4
# id = Bahasa Indonesia. auto = deteksi otomatis
WHISPER_LANGUAGE=id
WHISPER_DEVICE=cuda
# Kosong = default WhisperX. Jika Bahasa Indonesia tidak punya default, alignment dilewati otomatis
ALIGN_MODEL=

# --- Lain-lain ---
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=2048
# Isi path lengkap jika ffmpeg tidak ada di PATH
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
